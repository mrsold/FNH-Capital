{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role and contact information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["investor", "borrower", "admin"] },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Borrower": {
      "title": "Borrower",
      "description": "Borrower contact and identity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Investor": {
      "title": "Investor",
      "description": "Investor contact and identity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Loan": {
      "title": "Loan/Deal",
      "description": "Detailed loan records for properties",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "loanAmount": { "type": "number" },
        "amountRaised": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "isFeatured": { "type": "boolean" },
        "interestRate": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "maturityDate": { "type": "string", "format": "date" },
        "borrowerEmail": { "type": "string" },
        "borrowerName": { "type": "string" },
        "investorEmails": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Funding", "Closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["address", "loanAmount", "borrowerEmail"]
    },
    "LoanDocument": {
      "title": "Loan Document",
      "description": "A file associated with a loan",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url", "uploadedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Unified user accounts"
    },
    "/borrowers/{email}": {
      "schema": "Borrower",
      "description": "Dedicated borrower records"
    },
    "/investors/{email}": {
      "schema": "Investor",
      "description": "Dedicated investor records"
    },
    "/loans/{loanId}": {
      "schema": "Loan",
      "description": "Loan records and history"
    },
    "/loans/{loanId}/docs/{docId}": {
      "schema": "LoanDocument",
      "description": "Files associated with a loan"
    }
  }
}
