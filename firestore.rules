rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true &&
             (request.auth.token.email == 'mr.sold@gmail.com' || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['investor', 'borrower', 'admin'] &&
             data.displayName is string &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             (data.experience == null || data.experience is string) &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             // Optional fields based on role
             (data.role == 'investor' ? (
                (data.investAmount == null || data.investAmount is string) &&
                (data.isAccredited == null || data.isAccredited is bool)
             ) : true) &&
             (data.role == 'borrower' ? (
                (data.loanType == null || data.loanType is string) &&
                (data.loanAmount == null || data.loanAmount is number) &&
                (data.propertyValue == null || data.propertyValue is number) &&
                (data.duration == null || data.duration is string)
             ) : true);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    function isValidDeal(data) {
      return data.title is string && data.title.size() > 0 &&
             data.status in ['Active', 'Funding', 'Closed'];
    }

    match /deals/{dealId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDeal(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
