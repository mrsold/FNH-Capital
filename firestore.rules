rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        request.auth.token.email == 'mr.sold@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+@?[a-zA-Z0-9_\\-\\.]*$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    incoming().role != 'admin'; // Cannot self-promote to admin
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])) ||
        isAdmin()
      );
    }

    // Borrowers & Investors (CUD: Admin only, R: Admin or sometimes listed in loan)
    match /borrowers/{email} {
      allow read, write: if isAdmin();
    }

    match /investors/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Loans
    match /loans/{loanId} {
      function isValidLoan(data) {
        return data.address is string && data.address.size() <= 300 &&
               data.loanAmount is number && 
               (data.get('isFeatured', false) is bool) &&
               (data.get('images', []) is list) &&
               data.status in ['Active', 'Funding', 'Closed'];
      }

      allow list: if (
        resource.data.status != 'Closed' || 
        resource.data.get('isFeatured', false) == true ||
        isSignedIn()
      );

      allow get: if (
        resource.data.status != 'Closed' || 
        resource.data.get('isFeatured', false) == true ||
        isSignedIn()
      );

      allow create, update, delete: if isAdmin();

      // Loan Documents
      match /docs/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() || 
          get(/databases/$(database)/documents/loans/$(loanId)).data.status != 'Closed' ||
          (request.auth.token.email in get(/databases/$(database)/documents/loans/$(loanId)).data.investorEmails)
        );
        allow write: if isAdmin();
      }
    }
  }
}
